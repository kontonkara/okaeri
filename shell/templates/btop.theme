# okaeri's colors for btop, written anew as they change. With this written to
# ~/.config/btop/themes/okaeri.theme, in btop.conf:
#
#   color_theme = "okaeri"
#
# or picked in its options. btop takes them as it starts. Its graphs go from
# the accent toward the error color, the more they show.

theme[main_bg]="{{background}}"
theme[main_fg]="{{text}}"
theme[title]="{{text}}"
theme[hi_fg]="{{accent}}"
theme[selected_bg]="{{surface}}"
theme[selected_fg]="{{accent}}"
theme[inactive_fg]="{{dim}}"
theme[graph_text]="{{subtext}}"
theme[meter_bg]="{{surface}}"
theme[proc_misc]="{{accent}}"
theme[cpu_box]="{{surface}}"
theme[mem_box]="{{surface}}"
theme[net_box]="{{surface}}"
theme[proc_box]="{{surface}}"
theme[div_line]="{{surface}}"
theme[temp_start]="{{accent}}"
theme[temp_mid]=""
theme[temp_end]="{{error}}"
theme[cpu_start]="{{accent}}"
theme[cpu_mid]=""
theme[cpu_end]="{{error}}"
theme[free_start]="{{dim}}"
theme[free_mid]=""
theme[free_end]="{{accent}}"
theme[cached_start]="{{dim}}"
theme[cached_mid]=""
theme[cached_end]="{{accent}}"
theme[available_start]="{{dim}}"
theme[available_mid]=""
theme[available_end]="{{accent}}"
theme[used_start]="{{accent}}"
theme[used_mid]=""
theme[used_end]="{{error}}"
theme[download_start]="{{dim}}"
theme[download_mid]=""
theme[download_end]="{{accent}}"
theme[upload_start]="{{dim}}"
theme[upload_mid]=""
theme[upload_end]="{{accent}}"
theme[process_start]="{{accent}}"
theme[process_mid]=""
theme[process_end]="{{error}}"
