#!/bin/sh
# okaeri: a desktop shell on Quickshell.
#
#   okaeri                runs it, in a Wayland session
#   okaeri <target> ...   calls it, as a compositor's binds do: `okaeri launcher
#                         toggle`, `okaeri volume up 10`
#   okaeri dmenu [-p PROMPT] [--password] [--index] [--only-match] [--select LINE]
#                         shows the lines of standard input to pick one of, and
#                         prints it, as dmenu does for scripts. -p puts PROMPT
#                         in the field, as a last word alone does too;
#                         --password hides what's typed; --index prints where
#                         the line picked was among all of them, from 0;
#                         --only-match has only a line be the answer, never
#                         what's typed; --select starts on LINE
#   okaeri commands       lists what can be called, each target with its calls
#   okaeri doctor         says what of what it needs is on this machine, and what
#                         each missing thing is for; it ends in 1 if it can't
#                         run at all
set -eu

shell=${OKAERI_SHELL_DIR:-$(dirname "$(readlink -f "$0")")/../shell}

# A list to pick from, a line each on standard input: the launcher shows it, the
# line picked is printed, and with none picked it ends in 1. The prompt and the
# line to start on go to it in files: they can have anything in them, and the
# call's arguments can't have commas.
if [ "${1:-}" = dmenu ]; then
	shift
	prompt=
	select=
	options=
	while [ "$#" -gt 0 ]; do
		case $1 in
		-p | --select)
			[ "$#" -ge 2 ] || {
				echo "okaeri dmenu: $1 wants a value after it" >&2
				exit 2
			}
			if [ "$1" = -p ]; then
				prompt=$2
			else
				select=$2
			fi
			shift
			;;
		--password) options="$options password" ;;
		--index) options="$options index" ;;
		--only-match) options="$options only-match" ;;
		-*)
			echo "okaeri dmenu: there's no $1" >&2
			exit 2
			;;
		*) prompt=$1 ;;
		esac
		shift
	done
	dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/okaeri-dmenu.XXXXXX")
	trap 'rm -rf "$dir"' EXIT
	cat >"$dir/lines"
	printf '%s' "$prompt" >"$dir/prompt"
	printf '%s' "$select" >"$dir/select"
	mkfifo "$dir/answer"
	quickshell ipc -p "$shell" call -- launcher menuWith "$dir/lines" "$dir/answer" "${options# }" >/dev/null || exit 1
	picked=$(cat "$dir/answer")
	[ -n "$picked" ] || exit 1
	printf '%s\n' "$picked"
	exit 0
fi

# All there is to call, as the running shell has it.
if [ "${1:-}" = commands ]; then
	exec quickshell ipc -p "$shell" show
fi

# What it needs, and whether that's here: the two it can't do without first, then
# each tool with what's without it.
if [ "${1:-}" = doctor ]; then
	failed=0
	has() {
		command -v "$1" >/dev/null 2>&1
	}
	if has quickshell; then
		echo "ok       quickshell: $(quickshell --version 2>/dev/null | head -n 1)"
	else
		echo "MISSING  quickshell: okaeri is made of it, 0.3 or newer"
		failed=1
	fi
	if has niri; then
		echo "ok       niri: $(niri --version 2>/dev/null | head -n 1)"
	else
		echo "MISSING  niri: the compositor it's for, 26.04 or newer"
		failed=1
	fi
	# Of "one/other", either does.
	while IFS='|' read -r tool what; do
		there=false
		for one in $(echo "$tool" | tr / ' '); do
			! has "$one" || there=true
		done
		if [ "$there" = true ]; then
			echo "ok       $tool"
		else
			echo "missing  $tool: $what"
		fi
	done <<LIST
cliphist|the clipboard's history
wl-copy|the clipboard, from wl-clipboard
wl-paste|the clipboard's history, from wl-clipboard
wtype|pasting, and typing emoji
qalc|sums in the launcher
notify-send|its own notices: a recording saved, the battery low, a timer up
pw-play|sounds
wlsunset|the night light
wf-recorder|recording the screen
slurp|recording a part of the screen
ddcutil|the brightness of external monitors
nmcli|VPNs, the hotspot, the wired network, sharing Wi-Fi
qrencode|the code a phone joins Wi-Fi by
busctl|the battery's history, failed units, gamemode
top|the busiest processes on the load's card
xdg-open|opening files, folders and links
udisksctl|the drives one plugs in: mounting and ejecting them
kdeconnect-cli|a phone through KDE Connect, with kdeconnectd running
tesseract|the text in a screenshot, onto the clipboard
satty/swappy|editing a screenshot
pw-metadata|an app's own output, from PipeWire
curl|pictures from Wallhaven, fetched for the wallpaper
cava|the sound's bars on the bar
LIST
	if [ -n "${NIRI_SOCKET:-}" ] && has quickshell; then
		if quickshell ipc -p "$shell" show >/dev/null 2>&1; then
			echo "ok       it's running"
		else
			echo "note     it isn't running in this session"
		fi
	fi
	exit "$failed"
fi

[ "$#" -eq 0 ] || exec quickshell ipc -p "$shell" call -- "$@"

# With no screen on an NVIDIA GPU, only Mesa's EGL is offered: libglvnd would
# otherwise load NVIDIA's first, which wakes the GPU from its sleep.
uses_nvidia=false
for status in /sys/class/drm/card*-*/status; do
	[ "$(cat "$status" 2>/dev/null)" = connected ] || continue
	[ "$(cat "${status%/*}/device/device/vendor" 2>/dev/null)" != 0x10de ] || uses_nvidia=true
done
if [ "$uses_nvidia" = false ]; then
	for f in /run/opengl-driver/share/glvnd/egl_vendor.d/*mesa*.json \
		/etc/glvnd/egl_vendor.d/*mesa*.json /usr/share/glvnd/egl_vendor.d/*mesa*.json; do
		if [ -e "$f" ]; then
			export __EGL_VENDOR_LIBRARY_FILENAMES="$f"
			break
		fi
	done
fi

# A shell draws little, and Mesa's threads for each context would only take memory,
# with a context for every window.
export mesa_glthread=false GALLIUM_THREAD=0

export QT_QPA_PLATFORM=wayland QSG_RHI_BACKEND=opengl
# One at a time: started again, as niri and an install may both do, it leaves it.
exec quickshell -n -p "$shell"
